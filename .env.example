# Copy to .env and adjust. .env is gitignored.
#
# On the droplet this file is NOT hand-maintained: the deploy workflow builds
# it from repository secrets and variables and ships it inside the tar, so an
# edit made on the box is overwritten by the next deploy. Change the values in
# GitHub, not here. This file documents what the stack reads.
#
# Image tags deployed on the droplet. CI writes a sha-<short> tag to GHCR; pin
# these to that rather than :latest once the pipeline is running, so a deploy
# is a deliberate change and a rollback is a one-line edit.

SPLASH_TAG=latest

# --- Board games (apps/boardgames) ---
#
# These two tags come from the *board-game-api* repo's build, not this one, so
# the deploy workflow cannot derive them from its own sha the way it does
# SPLASH_TAG. They are repository *variables* (vars.BG_API_TAG,
# vars.BG_MCP_TAG), defaulting to latest when unset.
BG_API_TAG=latest
BG_MCP_TAG=latest

# Postgres superuser password. The superuser is used deliberately: the
# use_uuids migration runs CREATE EXTENSION pgcrypto, which an unprivileged
# role cannot do. Generate with: openssl rand -hex 32
BG_DB_PASSWORD=

# Shared secret required on API writes (POST/PUT/DELETE). Reads stay public.
# Generate with: openssl rand -hex 32
BG_WRITE_TOKEN=

# OIDC subjects allowed to use the MCP server, comma separated. Required
# whenever the MCP server runs in OAuth mode -- it refuses to start with this
# empty rather than defaulting to allowing everyone, because issuer, audience
# and scope checks prove a token is genuine but not who holds it.
#
# Subjects are opaque and cannot be known in advance. Attempt one login, read
# the rejected subject out of the MCP container's logs (the error names it),
# then set vars.BG_MCP_SUBJECTS. Not a credential, so a variable rather than a
# secret -- an allowlist you cannot read is an allowlist you cannot edit.
BG_MCP_SUBJECTS=

# Phase 2
# BG_UI_TAG=latest

# --- Dex (auth/) ---
DEX_GITHUB_CLIENT_ID=
DEX_GITHUB_CLIENT_SECRET=

# A hash of auth/config.yaml, which Dex never reads. It exists so Compose
# notices a config edit at all: config.yaml is bind-mounted, so changing it
# leaves the container spec identical and `up -d` does nothing, while Dex goes
# on serving the config it read at startup. The deploy workflow computes this
# from the file it ships; set it by hand only when running compose locally:
#   sha256sum auth/config.yaml | cut -c1-12
DEX_CONFIG_SHA=

# --- BoardGameGeek proxy (planned, board-game-api) ---
BGG_API_TOKEN=
