# Copy to .env and adjust. .env is gitignored.
#
# Image tags deployed on the droplet. CI writes a sha-<short> tag to GHCR;
# pin these to that rather than :latest once the pipeline is running, so a
# deploy is a deliberate change and a rollback is a one-line edit.

SPLASH_TAG=latest

